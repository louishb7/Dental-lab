APP_ENV=development
DATABASE_URL=postgresql+psycopg://cadista:cadista@localhost:5432/cadista
SECRET_KEY=change-this-to-a-unique-secret-with-at-least-32-characters

CORS_ORIGINS=http://localhost:5173
TRUSTED_HOSTS=localhost,127.0.0.1

# Use 0 for persistent sessions without automatic token expiration.
ACCESS_TOKEN_EXPIRE_MINUTES=0
BCRYPT_ROUNDS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
