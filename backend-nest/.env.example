DATABASE_URL=postgresql://cadisk_dev:cadisk_dev_password@localhost:5433/cadisk_nest?schema=public
DIRECT_URL=postgresql://cadisk_dev:cadisk_dev_password@localhost:5433/cadisk_nest?schema=public
SECRET_KEY=replace-with-at-least-32-characters
CORS_ORIGINS=http://localhost:5173

# Password recovery: backend only. Never use VITE_ for these variables.
# Public frontend origin; HTTPS in production, without paths, query or fragment.
FRONTEND_URL=http://localhost:5173
# Configure externally with a Resend sending API key. Do not commit the real value.
RESEND_API_KEY=
# Use a sender on your verified domain, e.g. Cadisk <acesso@mail.example.com>.
EMAIL_FROM="Cadisk <acesso@mail.example.com>"

# Optional local overrides. Render injects PORT automatically.
PORT=3001

# Test commands intentionally point to a separate database ending in _test.
TEST_DATABASE_URL=postgresql://cadisk_dev:cadisk_dev_password@localhost:5433/cadisk_nest_test?schema=public
