NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://cadisk_dev:cadisk_dev_password@localhost:5433/cadisk_nest?schema=public

# Test commands intentionally point to a separate database ending in _test.
TEST_DATABASE_URL=postgresql://cadisk_dev:cadisk_dev_password@localhost:5433/cadisk_nest_test?schema=public

# Auth variables implemented from Fase 3 onward.
SECRET_KEY=replace-with-at-least-32-characters
ALGORITHM=HS256
# Use 0 for persistent sessions without automatic token expiration.
ACCESS_TOKEN_EXPIRE_MINUTES=0
BCRYPT_ROUNDS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# Security/CORS variables implemented from Fase 8 onward.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
# Remove or leave undefined in production. Development/test allow local Vite fallback ports.
CORS_ORIGIN_REGEX='^http://(localhost|127\.0\.0\.1):[0-9]+$'
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
