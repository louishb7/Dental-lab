{
  "name": "cadista-backend-nest",
  "version": "0.1.0",
  "private": true,
  "description": "Cadista NestJS backend migration target.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node dist/main.js",
    "start:dev": "ts-node -r tsconfig-paths/register src/main.ts",
    "test": "jest --config jest.unit.config.js",
    "test:integration": "NODE_ENV=test DATABASE_URL=${TEST_DATABASE_URL:-postgresql://cadista:cadista_dev_password@localhost:5433/cadista_nest_test} jest --config jest.integration.config.js --runInBand",
    "test:e2e": "NODE_ENV=test DATABASE_URL=${TEST_DATABASE_URL:-postgresql://cadista:cadista_dev_password@localhost:5433/cadista_nest_test} jest --config jest.e2e.config.js --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:test": "NODE_ENV=test DATABASE_URL=postgresql://cadista:cadista_dev_password@localhost:5433/cadista_nest_test prisma migrate deploy"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@prisma/client": "^6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.15",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "prisma": "^6.19.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "allowScripts": {
    "@nestjs/core@10.4.22": true,
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true
  }
}
