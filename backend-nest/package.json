{
  "name": "cadisk-backend-nest",
  "version": "0.1.0",
  "private": true,
  "description": "Cadisk NestJS backend.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "api:dev": "npm run start:dev",
    "api:setup": "npm run prisma:generate && npm run prisma:migrate:deploy",
    "db:down:docker": "docker compose down",
    "db:up:docker": "docker compose up -d postgres",
    "dev": "npm run api:dev",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "setup:dev": "npm run api:setup",
    "start": "node dist/main.js",
    "start:dev": "set -a; . ./.env; set +a; ts-node -r tsconfig-paths/register src/main.ts",
    "test": "SECRET_KEY=${SECRET_KEY:-test-secret-key-for-cadisk-nest-auth} jest --config jest.unit.config.js",
    "test:integration": "set -a; . ./.env; set +a; NODE_ENV=test DATABASE_URL=\"${TEST_DATABASE_URL:-postgresql://cadisk_dev:cadisk_dev_password@localhost:5433/cadisk_nest_test?schema=public}\" SECRET_KEY=test-secret-key-for-cadisk-nest-auth jest --config jest.integration.config.js --runInBand",
    "test:e2e": "set -a; . ./.env; set +a; NODE_ENV=test DATABASE_URL=\"${TEST_DATABASE_URL:-postgresql://cadisk_dev:cadisk_dev_password@localhost:5433/cadisk_nest_test?schema=public}\" SECRET_KEY=test-secret-key-for-cadisk-nest-auth jest --config jest.e2e.config.js --runInBand",
    "prisma:generate": "set -a; . ./.env; set +a; prisma generate",
    "prisma:migrate:deploy": "set -a; . ./.env; set +a; DATABASE_URL=\"${DIRECT_URL:?DIRECT_URL must be defined for Prisma migrations.}\" prisma migrate deploy",
    "prisma:migrate:dev": "set -a; . ./.env; set +a; prisma migrate dev",
    "prisma:migrate:test": "set -a; . ./.env; set +a; NODE_ENV=test DATABASE_URL=${TEST_DATABASE_URL:-postgresql://cadisk_dev:cadisk_dev_password@localhost:5433/cadisk_nest_test?schema=public} prisma migrate deploy"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.28",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prisma": "^6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.28",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "allowScripts": {
    "@nestjs/core@11.1.28": true,
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true
  }
}
